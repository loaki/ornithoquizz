{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quizzozoizo",
  "version": "0.2.2",
  "identifier": "dev.loaki.quizzozoizo",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build --release",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Quizzozoizo", "width": 420, "height": 860 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"] }
}
